# --- Database ---
DATABASE_URL=postgresql://pda:pda@localhost:5432/pd_assessment

# --- Session ---
# 32+ char secret for iron-session cookie encryption
SESSION_SECRET=change-me-to-a-random-32+-char-secret

# --- Storage ---
# local | s3
STORAGE_DRIVER=local
# for local driver: directory for media/pdf files
STORAGE_LOCAL_DIR=./storage
# for s3 driver:
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers ---
# real | mock  (mock = deterministic fixtures, no API keys needed; for dev/test only)
AI_DRIVER=mock
ANTHROPIC_API_KEY=
# judge / generation / vision model (Claude)
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- PDF ---
# Path to a Chromium executable for Playwright PDF rendering
CHROMIUM_PATH=/opt/pw-browsers/chromium

# --- ffmpeg ---
FFMPEG_PATH=ffmpeg
